// ============================================================================
//  remokey 资源脚本
// ============================================================================
#include <windows.h>

// 应用程序图标（任务栏、Alt+Tab、资源管理器都使用它）
// IDI_ICON1 = 1，是 Windows 约定的主图标 ID，通常直接用 1
IDI_ICON1  ICON  DISCARDABLE  "remokey.ico"

// 版本信息（可选，但推荐，用于文件属性页）
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"        // 美国英语 + Unicode
        BEGIN
            VALUE "CompanyName",      "remokey"
            VALUE "FileDescription",  "Remote Keyboard"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "remokey"
            VALUE "OriginalFilename", "remokey.exe"
            VALUE "ProductName",      "remokey"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
